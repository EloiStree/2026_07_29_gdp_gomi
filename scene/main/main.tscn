[node name="TextEdit" type="TextEdit" parent="CanvasLayer/GOMI Main/GOMI TAB/About/ScrollContainer" unique_id=902887407]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
text = "GOMI is a tool designed by Eloi Stree to allow input remapping and help people learn to code.
Feel free to ping me on Discord:
- If you are a QA tester or a QA company and need assistance.
- If you have a disability and want to play a game.
- If you are trying to learn to code but video and text guides are not enough.

This software does NOT simulate input.
It is a control hub that reads input and turns it into actions and macros.
You need to add a keylogger yourself if you want it to read your keyboard outside of the application.

I designed this tool in Godot because GDScript is highly moddable.
Feel free to hook into the tool or add your own code.

All the code in this application are opensource toolbox in Godot on GitHub.  
https://github.com/EloiStree?tab=repositories&q=_gdp_  

Under Pizza License: https://github.com/EloiStree/license   

/*
 * ----------------------------------------------------------------------------
 * \"PIZZA LICENSE\":
 * https://github.com/EloiStree wrote this file.
 * As long as you retain this notice you
 * can do whatever you want with this stuff.
 * If you think my code made you win a day of work,
 * send me a good 🍺 or a 🍕 at
 *  - https://buymeacoffee.com/apintio
 * 
 * May the code be with you.
 *
 * Updated version: https://github.com/EloiStree/License
 * ----------------------------------------------------------------------------
 */"

